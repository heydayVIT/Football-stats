<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Статистика футболистов</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; }
        .player { cursor: pointer; margin: 10px; display: inline-block; padding: 10px; border: 1px solid black; }
    </style>
</head>
<body>
    <h1>Выберите футболиста</h1>
    <div class="player" onclick="showStats('Месси')">Лионель Месси</div>
    <div class="player" onclick="showStats('Роналду')">Криштиану Роналду</div>
    
    <h2 id="stats"></h2>

    <script>
        function showStats(player) {
            const stats = {
                "Месси": "Голы: 800, Ассисты: 350",
                "Роналду": "Голы: 850, Ассисты: 300"
            };
            document.getElementById("stats").innerText = stats[player] || "Статистика не найдена";
        }
    </script>
</body>
</html>
